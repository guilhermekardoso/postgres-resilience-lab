# --- Banco (mudar exige: docker compose up -d postgres) ---
PG_CPUS=0.5
PG_MEM=256m
PG_MAX_CONNECTIONS=30

# --- API (mudar exige: docker compose up -d api) ---
POOL_MAX_SIZE=10

# Camada de resiliência (lidos em app/config.py)
TIMEOUT_MS=1000
# 3 vagas rendeu mais que 6: com menos consultas simultâneas, nenhuma estoura o prazo.
BULKHEAD_MAX_CONCURRENT=3
BULKHEAD_MAX_WAIT_MS=50
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RECOVERY_MS=5000

# --- Gerador de carga (também ajustável em http://localhost:8001) ---
NORMAL_RPS=4
BURST_RPS=15
